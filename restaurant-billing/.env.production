# A5 Confectioners - Production Environment
# Copy this to .env and update with production values

# Server Configuration
PORT=3001
NODE_ENV=production

# Security
JWT_SECRET=change-this-to-a-secure-random-string-min-32-chars

# Restaurant Details
RESTAURANT_NAME=A5 Confectioners
UPI_ID=your-upi-id@upi

# Database (auto-created)
DATABASE_PATH=./restaurant.db

# Public URLs (for Railway: automatically set)
CLIENT_URL=https://your-domain.railway.app
APP_URL=https://your-domain.railway.app

# SMS Integration (Optional - set these for Twilio support)
TWILIO_ACCOUNT_SID=optional-your-twilio-account-sid
TWILIO_AUTH_TOKEN=optional-your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Notes:
# - SMS works in demo mode without Twilio credentials
# - Change JWT_SECRET to a secure random string
# - Update UPI_ID to your actual UPI ID
# - CLIENT_URL and APP_URL should be your Railway domain
# - Twilio variables are optional (SMS works in demo mode without them)
